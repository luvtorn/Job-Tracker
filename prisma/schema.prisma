// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SEEKER
  RECRUITER
  ADMIN
}

enum AuthProvider {
  GOOGLE
  GITHUB
}

enum AuthActionType {
  VERIFY_EMAIL
  PASSWORD_RESET
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  email        String  @unique
  passwordHash String? @map("password_hash")

  firstName String? @map("first_name")
  lastName  String? @map("last_name")

  avatarUrl      String? @map("avatar_url")
  avatarPublicId String? @map("avatar_public_id")

  emailVerified Boolean @default(false) @map("email_verified")
  authVersion   Int     @default(0) @map("auth_version")

  role UserRole @default(SEEKER)

  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  refreshTokens            RefreshToken[]
  authAccounts             AuthAccount[]
  authActionTokens         AuthActionToken[]
  googleCalendarConnection GoogleCalendarConnection?
  calendarSyncJobs         CalendarSyncJob[]
  vacancies                Vacancy[]
  applications             Application[]
  wishlist                 Wishlist[]
  notifications            Notification[]
  calendarEvents           CalendarEvent[]
  documents                Document[]
  contacts                 Contact[]
  applicationNotes         ApplicationNote[]
  tags                     Tag[]

  @@index([email])
  @@index([role])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model AuthAccount {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  provider          AuthProvider
  providerAccountId String       @map("provider_account_id") @db.VarChar(255)

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_accounts")
}

model AuthActionToken {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tokenHash String         @unique @map("token_hash") @db.VarChar(64)
  type      AuthActionType
  expiresAt DateTime       @map("expires_at")

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_action_tokens")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum VacancyStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  APPLIED
  INTERVIEWING
  REJECTED
  OFFER
  ACCEPTED
  WITHDRAWN
}

enum CalendarEventType {
  INTERVIEW
  MEETING
  DEADLINE
  FOLLOW_UP
  NOTE
  OTHER
}

enum InterviewMeetingType {
  NONE
  MANUAL_GOOGLE_MEET
  GOOGLE_MEET
}

enum CalendarSyncState {
  NOT_REQUIRED
  PENDING
  SYNCED
  FAILED
}

enum CalendarSyncOperation {
  UPSERT
  DELETE
}

enum CalendarSyncJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum DocumentType {
  RESUME
  COVER_LETTER
}

enum DocumentScanStatus {
  PENDING_UPLOAD
  SCANNING
  CLEAN
  REJECTED
  FAILED
}

model Vacancy {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  title        String
  description  String
  requirements String?

  position  String?
  company   String?
  location  String?
  salaryMin Int?    @map("salary_min")
  salaryMax Int?    @map("salary_max")
  currency  String  @default("USD")

  status VacancyStatus @default(DRAFT)

  recruiterId String @db.Uuid
  recruiter   User   @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  applications Application[]
  wishlist     Wishlist[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at")
  closedAt    DateTime? @map("closed_at")
  expiresAt   DateTime? @map("expires_at")
  archivedAt  DateTime? @map("archived_at")

  @@index([recruiterId])
  @@index([status])
  @@index([archivedAt])
  @@index([expiresAt])
  @@index([createdAt(sort: Desc)])
  @@map("vacancies")
}

model Application {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  status ApplicationStatus @default(APPLIED)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vacancyId String  @db.Uuid
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  interviewDate  DateTime? @map("interview_date")
  interviewTime  String?   @map("interview_time")
  interviewNotes String?   @map("interview_notes")

  calendarEvent CalendarEvent?
  documents     ApplicationDocument[]
  notes         ApplicationNote[]
  tags          ApplicationTag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, vacancyId])
  @@index([userId])
  @@index([vacancyId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("applications")
}

model Document {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             DocumentType
  originalFilename String       @map("original_filename") @db.VarChar(255)
  publicId         String       @map("public_id")
  isCurrent        Boolean      @default(true) @map("is_current")
  scanStatus       DocumentScanStatus @default(CLEAN) @map("scan_status")
  uploadExpiresAt  DateTime?    @map("upload_expires_at")

  userId       String                @db.Uuid
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications ApplicationDocument[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, type, isCurrent])
  @@unique([publicId])
  @@index([scanStatus, uploadExpiresAt])
  @@map("documents")
}

model ApplicationDocument {
  applicationId String       @db.Uuid
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentId    String       @db.Uuid
  document      Document     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  type          DocumentType

  @@id([applicationId, type])
  @@index([documentId])
  @@map("application_documents")
}

model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String?
  phone     String?
  role      String?
  notes     String?  @db.Text
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("contacts")
}

model ApplicationNote {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content       String      @db.Text
  userId        String      @db.Uuid
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@index([applicationId])
  @@map("application_notes")
}

model Tag {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String           @db.VarChar(50)
  color        String           @default("blue") @db.VarChar(32)
  userId       String           @db.Uuid
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications ApplicationTag[]
  createdAt    DateTime         @default(now()) @map("created_at")

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model ApplicationTag {
  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tagId         String      @db.Uuid
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([applicationId, tagId])
  @@index([tagId])
  @@map("application_tags")
}

model Wishlist {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vacancyId String  @db.Uuid
  vacancy   Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, vacancyId])
  @@index([userId])
  @@index([vacancyId])
  @@map("wishlist")
}

model Notification {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  type     String
  title    String
  message  String
  metadata Json?
  isRead   Boolean @default(false) @map("is_read")

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  applicationId String? @db.Uuid
  vacancyId     String? @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model CalendarEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  title       String            @db.VarChar(255)
  description String?           @db.Text
  eventType   CalendarEventType @default(INTERVIEW)
  color       String            @default("blue")

  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  applicationId String?      @unique @db.Uuid
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  location    String?
  isCompleted Boolean @default(false) @map("is_completed")

  meetingType               InterviewMeetingType @default(NONE) @map("meeting_type")
  meetingUrl                String?              @map("meeting_url") @db.VarChar(500)
  sendCalendarInvite        Boolean              @default(false) @map("send_calendar_invite")
  googleEventId             String?              @unique @map("google_event_id") @db.VarChar(255)
  googleConferenceRequestId String?              @map("google_conference_request_id") @db.VarChar(64)
  syncState                 CalendarSyncState    @default(NOT_REQUIRED) @map("sync_state")
  syncErrorCode             String?              @map("sync_error_code") @db.VarChar(100)

  syncJob CalendarSyncJob?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([applicationId])
  @@index([startTime(sort: Asc)])
  @@index([eventType])
  @@map("calendar_events")
}

model GoogleCalendarConnection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  googleAccountEmail    String    @map("google_account_email") @db.VarChar(320)
  encryptedRefreshToken String    @map("encrypted_refresh_token") @db.Text
  scopes                String    @db.Text
  revokedAt             DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("google_calendar_connections")
}

model CalendarSyncJob {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  calendarEventId String?        @unique @map("calendar_event_id") @db.Uuid
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)

  operation     CalendarSyncOperation
  status        CalendarSyncJobStatus @default(PENDING)
  googleEventId String?               @map("google_event_id") @db.VarChar(255)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now()) @map("next_attempt_at")
  lockedAt      DateTime?             @map("locked_at")
  lastErrorCode String?               @map("last_error_code") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status, nextAttemptAt])
  @@map("calendar_sync_jobs")
}
